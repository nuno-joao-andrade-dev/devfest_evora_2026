# Option A (Default): Local Ollama on your laptop
OLLAMA_HOST=http://localhost:11434

# Option B (Workshop Backup): Uncomment & set the live URL shared by the instructor
# OLLAMA_HOST=http://<WORKSHOP_OLLAMA_ENDPOINT_PROVIDED_LIVE>:11434

# Required Ollama models
OLLAMA_MODEL=gemma4:e2b
OLLAMA_EMBED_MODEL=embeddinggemma-2

# Optional emergency cloud fallback
# GEMINI_API_KEY=your_api_key_here
